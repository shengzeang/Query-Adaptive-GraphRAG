# --- Backbone LLM that answers the questions (default: the paper's Qwen2.5-7B-Instruct served by vLLM)
#     `bash scripts/run_all.sh serve` starts one replica per GPU (V100: --dtype half, VLLM_USE_V1=0).
#     Several endpoints can be given comma-separated; requests are spread over them round-robin:
#     BACKBONE_BASE_URL=http://localhost:8000/v1,http://localhost:8001/v1,...
BACKBONE_BASE_URL=http://localhost:8000/v1
BACKBONE_MODEL=Qwen/Qwen2.5-7B-Instruct
BACKBONE_API_KEY=EMPTY

# --- LLM that writes the RAPTOR summaries (optional; defaults to the backbone settings above)
# SUMMARIZER_BASE_URL=
# SUMMARIZER_MODEL=
# SUMMARIZER_API_KEY=

# --- GraphRAG-Bench judge (DeepSeek flash, official protocol). Only the `check` and `bench` stages need it.
#     Never commit the key.
DEEPSEEK_API_KEY=
# JUDGE_MODEL=deepseek-flash
# JUDGE_BASE_URL=https://api.deepseek.com
